{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window — core permissions for Jambubrowser",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:default",
    "core:webview:default",
    "core:app:default",
    "core:event:default",
    "core:menu:default",
    "core:tray:default",
    "opener:default",
    "notification:default",
    "process:default",
    "deep-link:default",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "binaries/llama-server",
          "sidecar": true
        },
        {
          "name": "binaries/llama-server",
          "sidecar": true,
          "args": ["--port", "8080", "--model", "gemma-4-12b"]
        }
      ]
    },
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "python3",
          "args": ["-m", "uvicorn", "backend.engine:app", "--port", "8001"]
        },
        {
          "name": "python3.11",
          "args": ["-m", "uvicorn", "backend.engine:app", "--port", "8001"]
        }
      ]
    },
    {
      "identifier": "shell:allow-open",
      "allow": [
        { "url": "https://*" },
        { "url": "http://localhost:*" },
        { "url": "http://127.0.0.1:*" }
      ]
    }
  ]
}
