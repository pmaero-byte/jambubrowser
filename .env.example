# ─────────────────────────────────────────────────────────────
# Jambubrowser — Environment variables
# ─────────────────────────────────────────────────────────────
# Copy this file to `.env` and fill in the values. Never commit
# `.env` to git (already in .gitignore).
#
# For local dev, the defaults below are sufficient. For production
# builds, set the Apple signing + GitHub tokens.
# ─────────────────────────────────────────────────────────────

# ── Backend ──────────────────────────────────────────────────
# Path to the SQLite database (default: ./rag_data.db)
# JAMBU_DB_PATH=./rag_data.db

# Vault master key — used to derive AES-256-GCM key (32+ bytes)
# Generate with: openssl rand -hex 32
# JAMBU_VAULT_KEY=replace-me-with-32-bytes-of-randomness

# Server bind address
# JAMBU_HOST=127.0.0.1
# JAMBU_PORT=8001

# SearXNG instance URL (optional, for metasearch)
# SEARXNG_URL=http://localhost:8888/search

# SOCKS5 proxy for Tor routing (optional)
# AGENT_VPN_PROXY=socks5://127.0.0.1:9050


# ── LLM Providers (v3) ───────────────────────────────────────
# Default provider. "auto" picks the first healthy in the fallback chain.
# Options: auto, ollama, mlx, anthropic, openai, minimax, mock
# JAMBU_LLM_PROVIDER=auto

# Comma-separated fallback order (first healthy wins)
# JAMBU_LLM_FALLBACK_CHAIN=ollama,mlx,anthropic,openai,minimax

# Privacy: refuse cloud providers
# JAMBU_LLM_LOCAL_ONLY=false

# Per-request timeouts (seconds)
# JAMBU_LLM_TIMEOUT=30
# JAMBU_LLM_HEALTH_TIMEOUT=3
# JAMBU_LLM_MAX_TOKENS=1024
# JAMBU_LLM_TEMPERATURE=0.3

# Provider credentials
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# MINIMAX_API_KEY=...

# Per-provider model + base URL overrides
# JAMBU_LLM_ANTHROPIC_MODEL=claude-sonnet-4-6
# JAMBU_LLM_OPENAI_MODEL=gpt-4o
# JAMBU_LLM_OLLAMA_MODEL=gemma4:12b-it-qat
# JAMBU_LLM_MLX_MODEL=gemma-4-12b
# JAMBU_LLM_MINIMAX_MODEL=MiniMax-M2.7
# JAMBU_LLM_OPENAI_BASE_URL=https://api.openai.com/v1


# ── Tauri Build / Code Signing (macOS) ───────────────────────
# Apple Developer ID signing identity. Find with:
#   security find-identity -v -p codesigning
# APPLE_SIGNING_IDENTITY="Developer ID Application: Jambu AI (XXXXXXXXXX)"

# Your Apple ID email
# APPLE_ID=your@apple.id

# App-specific password from https://appleid.apple.com/account/manage
# APPLE_PASSWORD=xxxx-xxxx-xxxx-xxxx

# 10-character Apple Developer Team ID
# APPLE_TEAM_ID=XXXXXXXXXX

# Tauri updater signing (generated by ./scripts/gen-updater-keys.sh)
# Private key is used at build time, never committed.
# TAURI_SIGNER_PRIVATE_KEY=
# TAURI_SIGNER_PRIVATE_KEY_PASSWORD=


# ── GitHub Actions / CI (for releases) ───────────────────────
# Create a GitHub PAT with `repo` scope for releases.
# GITHUB_TOKEN is provided automatically by Actions.
# GH_TOKEN=ghp_xxxx


# ── Optional integrations ────────────────────────────────────
# MLX VLM server settings
# MLX_VLM_PORT=8080
# MLX_VLM_MODEL=mlx-community/gemma-4-12b-it-4bit

# OpenTelemetry endpoint (for observability, future)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# OTEL_SERVICE_NAME=jambubrowser

# Sentry DSN (for error tracking, future)
# SENTRY_DSN=https://xxxx@sentry.io/xxxx
