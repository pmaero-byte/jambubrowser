# ─────────────────────────────────────────────────────────────
# Jambubrowser — Environment variables
# ─────────────────────────────────────────────────────────────
# Copy this file to `.env` and fill in the values. Never commit
# `.env` to git (already in .gitignore).
#
# For local dev, the defaults below are sufficient. For production
# builds, set the Apple signing + GitHub tokens.
# ─────────────────────────────────────────────────────────────

# ── Backend ──────────────────────────────────────────────────
# Path to the SQLite database (default: ./rag_data.db)
# JAMBU_DB_PATH=./rag_data.db

# Vault master key — used to derive AES-256-GCM key (32+ bytes)
# Generate with: openssl rand -hex 32
# JAMBU_VAULT_KEY=replace-me-with-32-bytes-of-randomness

# Server bind address
# JAMBU_HOST=127.0.0.1
# JAMBU_PORT=8001

# SearXNG instance URL (optional, for metasearch)
# SEARXNG_URL=http://localhost:8888/search

# SOCKS5 proxy for Tor routing (optional)
# AGENT_VPN_PROXY=socks5://127.0.0.1:9050


# ── LLM Providers (v3) ───────────────────────────────────────
# Default provider. "auto" picks the first healthy in the fallback chain.
# Options: auto, ollama, mlx, anthropic, openai, minimax, mock
# JAMBU_LLM_PROVIDER=auto

# Comma-separated fallback order (first healthy wins)
# JAMBU_LLM_FALLBACK_CHAIN=ollama,mlx,anthropic,openai,minimax

# Privacy: refuse cloud providers
# JAMBU_LLM_LOCAL_ONLY=false

# Per-request timeouts (seconds)
# JAMBU_LLM_TIMEOUT=30
# JAMBU_LLM_HEALTH_TIMEOUT=3
# JAMBU_LLM_MAX_TOKENS=1024
# JAMBU_LLM_TEMPERATURE=0.3

# Provider credentials
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# MINIMAX_API_KEY=...

# Per-provider model + base URL overrides
# JAMBU_LLM_ANTHROPIC_MODEL=claude-sonnet-4-5
# JAMBU_LLM_OPENAI_MODEL=gpt-4o
# JAMBU_LLM_OLLAMA_MODEL=gemma3:4b
# JAMBU_LLM_MLX_MODEL=gemma-3-12b-it-4bit
# JAMBU_LLM_MINIMAX_MODEL=MiniMax-M2
# JAMBU_LLM_OPENAI_BASE_URL=https://api.openai.com/v1


# ── Tauri Build / Code Signing (macOS) ───────────────────────
# Apple Developer ID signing identity. Find with:
#   security find-identity -v -p codesigning
# APPLE_SIGNING_IDENTITY="Developer ID Application: Jambu AI (XXXXXXXXXX)"

# Your Apple ID email
# APPLE_ID=your@apple.id

# App-specific password from https://appleid.apple.com/account/manage
# APPLE_PASSWORD=xxxx-xxxx-xxxx-xxxx

# 10-character Apple Developer Team ID
# APPLE_TEAM_ID=XXXXXXXXXX

# Tauri updater signing (generated by ./scripts/gen-updater-keys.sh)
# Private key is used at build time, never committed.
# TAURI_SIGNER_PRIVATE_KEY=
# TAURI_SIGNER_PRIVATE_KEY_PASSWORD=


# ── GitHub Actions / CI (for releases) ───────────────────────
# Create a GitHub PAT with `repo` scope for releases.
# GITHUB_TOKEN is provided automatically by Actions.
# GH_TOKEN=ghp_xxxx


# ── Optional integrations ────────────────────────────────────
# MLX VLM server settings
# MLX_VLM_PORT=8080
# MLX_VLM_MODEL=mlx-community/gemma-3-12b-it-4bit-it-4bit

# OpenTelemetry endpoint (for observability, future)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# OTEL_SERVICE_NAME=jambubrowser

# Sentry DSN (for error tracking, future)
# SENTRY_DSN=https://xxxx@sentry.io/xxxx


# ── Dynamic VPN (optional) ───────────────────────────────────
# Two layers: a tunnel (WireGuard/OpenVPN) as base egress, plus a
# rotating proxy pool on top. Inert unless JAMBU_VPN_ENABLED=1.
# Full reference: docs/VPN.md
#
# --- Pool layer ---
# Comma-separated proxy URLs. Use socks5h:// so DNS resolves via the proxy.
# JAMBU_VPN_ENABLED=1
# JAMBU_VPN_POOL=socks5h://user:pass@eu1.example:1080,socks5h://user:pass@us1.example:1080
# failover (sticky) | round_robin | random | least_latency | least_latency_low_risk
# JAMBU_VPN_ROTATION=round_robin
# JAMBU_VPN_STICKY_TTL=300
# Consecutive failures before an endpoint is quarantined
# JAMBU_VPN_FAILURE_THRESHOLD=3
# Only use endpoints tagged with these regions (set via the API/pool.add)
# JAMBU_VPN_REGIONS=eu,us
# Active health probing: unset = passive (learns from real request outcomes)
# JAMBU_VPN_HEALTH_PROBE_URL=https://example.com/healthz
# JAMBU_VPN_HEALTH_INTERVAL=30
# JAMBU_VPN_HEALTH_TIMEOUT=5
# Persist pool health to a JSON file so a restart keeps learned quarantines.
# JAMBU_VPN_STATE_FILE=~/.jambubrowser/vpn_pool.json
# JAMBU_VPN_STATE_MAX_AGE=86400
#
# --- Tunnel layer ---
# Managing a real tunnel requires root plus the vendor binary
# (wg-quick + wg, or openvpn + pkill).
# JAMBU_VPN_TUNNEL=wireguard
# JAMBU_VPN_TUNNEL_INTERFACE=wg0
# JAMBU_VPN_TUNNEL_ENDPOINT=vpn.example.com:51820
# JAMBU_VPN_TUNNEL_CONFIG=/etc/wireguard/wg0.conf
# JAMBU_VPN_TUNNEL_DNS=1.1.1.1,9.9.9.9
# Post-quantum key-exchange sidecar (classical Curve25519 alone is fine for
# most, but a long-lived audit trail should cite Rosenpass if you ship one).
# JAMBU_VPN_PQ=rosenpass
#
# --- Safety switches ---
# Fail CLOSED by default: if VPN is required and no endpoint works, the
# request errors rather than silently using your real IP. Set to 1 to allow
# a direct-connection fallback instead.
# JAMBU_VPN_FAIL_OPEN=0
# Exercise the whole code path (tunnel included) without root or a real VPN.
# JAMBU_VPN_DRY_RUN=0
#
# --- Simulation compute (docs/SIMULATION_COMPUTE.md) ---
# Decentralised simulation jobs: freeze a spec, dispatch to mesh nodes,
# compare replicas numerically, settle only if they agreed.
# Requires JAMBU_ENABLE_DECENTRALIZED=1.
# Pricing — configuration, NOT an oracle. DCM's receipts are the settlement
# source of truth; these rates only drive quoting and the tier decision.
# JAMBU_SIM_BASE_DCT=0.001
# JAMBU_SIM_PER_STEP_DCT=0.00001
# JAMBU_SIM_REPLICATE_DCT=0.00005
# JAMBU_SIM_DCT_USD=0.01
# Work shape defaults
# JAMBU_SIM_DEFAULT_STEPS=1000
# JAMBU_SIM_TIMEOUT_MS=30000
# JAMBU_SIM_MAX_REPLICAS=5
# Consecutive node failures before a node is quarantined. The quarantine
# window expires on its own, so a node recovers without a restart.
# JAMBU_SIM_FAILURE_THRESHOLD=2
# Replica comparison tolerances (numeric comparator). Solver output that
# differs by more than this is a MISMATCH -> job quarantined, not charged.
# JAMBU_SIM_ABS_TOL=1e-12
# JAMBU_SIM_REL_TOL=1e-9
# Durable queue: worker drains QUEUED rows FIFO, re-queues RUNNING jobs left
# by a crash. The engine must also have JAMBU_ENABLE_DECENTRALIZED=1.
# JAMBU_SIM_QUEUE=1
